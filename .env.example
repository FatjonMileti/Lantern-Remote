# Renderer (Vite injects VITE_* vars at build time)
VITE_SIGNALING_SERVER_URL=http://localhost:3001
# Comma-separated STUN URLs for WebRTC (TURN entries can be appended later)
VITE_STUN_SERVERS=stun:stun.l.google.com:19302

# Signaling server
SIGNALING_PORT=3001

# Optional: second local app instance (different persisted device ID)
# LANTERN_USER_DATA=/tmp/lantern-client-b
# LANTERN_ALLOW_MULTI_INSTANCE=1
